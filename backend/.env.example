# Copy this file to .env and fill in every value.
# The backend checks these at startup and stops with a clear message if a
# required one is missing (src/config/checkEnv.js). Never commit .env itself.

# ── Server ──
PORT=5000
NODE_ENV=development

# ── Database (required) ──
# postgresql://USER:PASSWORD@localhost:5432/ponytail
DATABASE_URL=

# ── Sign-in (required) ──
# Long random secret that signs login tokens; at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts, e.g. 7d, 12h, 30m
JWT_EXPIRES_IN=7d
# Another long random secret (same command as above, run again)
SESSION_SECRET=

# ── Google sign-in (off until email verification exists, SECURITY_RISKS.md SR-32) ──
GOOGLE_SIGNIN_ENABLED=false
# Only needed when GOOGLE_SIGNIN_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Hosting (leave empty when running locally) ──
# Number of proxies in front of the app, usually 1 (SECURITY_RISKS.md SR-09)
TRUST_PROXY=
